
{% liquid
  assign linked_colors = product.metafields.custom.linked_colors.value
  assign current_color = product.metafields.custom.color_name.value
%}

{% if linked_colors != blank %}
  <div class="global-color-swatches">
    <p class="global-color-title">
      Color: {{ current_color | escape }}
    </p>
    <div class="global-color-list">
      {% for linked_product in linked_colors %}
        {% assign color_name = linked_product.metafields.custom.color_name.value | default: linked_product.title %}
        <a href="{{ linked_product.url }}"
           class="global-color-item{% if linked_product.id == product.id %} active{% endif %}"
           title="{{ color_name | escape }}"
           aria-label="{{ color_name | escape }}">
          {% if linked_product.featured_image %}
            {{
              linked_product.featured_image
              | image_url: width: 160
              | image_tag: loading: 'lazy', alt: color_name
            }}
          {% else %}
            {{ color_name | escape }}
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
{% endif %}

<style>
.global-color-swatches { margin: 20px 0; }
.global-color-title { font-size: 16px; margin-bottom: 14px; }
.global-color-list { display: flex; flex-wrap: wrap; gap: 12px; }
.global-color-item {
  width: 65px;
  height: 65px;
  padding: 3px;
  border: 2px solid transparent;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
}
.global-color-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
}
.global-color-item.active { border-color: #333; }
.global-color-item:hover { border-color: #888; }
</style>
