{% comment %}
  Determines whether the product's selected variant is a preorder.
  Outputs 'true' when the variant is tracked by Shopify, uses the
  "continue selling when out of stock" policy, and has no stock left.
  Outputs nothing otherwise, so callers should capture the output.

  Accepts:
  - product: {Object} product object.

  Usage:
  {%- capture is_preorder -%}{% render 'preorder-flag', product: product %}{%- endcapture -%}
{% endcomment %}
{%- liquid
  assign v = product.selected_or_first_available_variant
  if v.inventory_management == 'shopify' and v.inventory_policy == 'continue' and v.inventory_quantity <= 0
    echo 'true'
  endif
-%}
