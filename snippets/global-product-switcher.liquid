
{% comment %}
  Dynamic Color + Length Picker
  Source: Product Group metaobject
  Fields:
  custom.product_group
  custom.product_color
  custom.product_length
{% endcomment %}

{% assign group = product.metafields.custom.product_group.value %}

{% if group != blank %}
  {% assign group_products = group.products.value %}
  {% assign current_color = product.metafields.custom.product_color.value %}
  {% assign current_length = product.metafields.custom.product_length.value %}

  <div class="dynamic-product-picker">

    {% comment %} Color Swatches {% endcomment %}
    <div class="dynamic-picker-colors">
      <p>Color: <strong>{{ current_color }}</strong></p>

      <div class="dynamic-color-list">
        {% assign shown_colors = '|' %}

        {% for linked_product in group_products %}
          {% assign linked_color = linked_product.metafields.custom.product_color.value %}
          {% assign linked_length = linked_product.metafields.custom.product_length.value %}
          {% assign color_key = linked_color | downcase | strip %}
          {% assign color_token = color_key | prepend: '|' | append: '|' %}

          {% if linked_color != blank and linked_length == current_length %}
            {% unless shown_colors contains color_token %}
              <a
                href="{{ linked_product.url }}"
                class="dynamic-color-item {% if linked_product.id == product.id %}is-active{% endif %}"
                title="{{ linked_color | escape }}"
                aria-label="{{ linked_color | escape }}"
              >
                {% if linked_product.featured_image %}
                  {{
                    linked_product.featured_image
                    | image_url: width: 120
                    | image_tag: loading: 'lazy', alt: linked_color
                  }}
                {% else %}
                  <span>{{ linked_color }}</span>
                {% endif %}
              </a>

              {% assign shown_colors = shown_colors | append: color_key | append: '|' %}
            {% endunless %}
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% comment %} Tall / Regular Picker {% endcomment %}
    {% if current_length != blank %}
      <div class="dynamic-picker-lengths">
        <p>Length: <strong>{{ current_length }}</strong></p>

        <div class="dynamic-length-list">
          {% assign shown_lengths = '|' %}

          {% for linked_product in group_products %}
            {% assign linked_color = linked_product.metafields.custom.product_color.value %}
            {% assign linked_length = linked_product.metafields.custom.product_length.value %}
            {% assign length_key = linked_length | downcase | strip %}
            {% assign length_token = length_key | prepend: '|' | append: '|' %}

            {% if linked_length != blank and linked_color == current_color %}
              {% unless shown_lengths contains length_token %}
                <a
                  href="{{ linked_product.url }}"
                  class="dynamic-length-item {% if linked_product.id == product.id %}is-active{% endif %}"
                >
                  {{ linked_length }}
                </a>

                {% assign shown_lengths = shown_lengths | append: length_key | append: '|' %}
              {% endunless %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

  </div>
{% endif %}

<style>
  .dynamic-product-picker {
    margin: 20px 0;
    text-align: center;
  }

  .dynamic-picker-colors,
  .dynamic-picker-lengths {
    margin-bottom: 20px;
  }

  .dynamic-color-list,
  .dynamic-length-list {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .dynamic-color-item {
    width: 54px;
    height: 54px;
    display: block;
    overflow: hidden;
    border-radius: 50%;
    border: 2px solid transparent;
    padding: 3px;
  }

  .dynamic-color-item.is-active {
    border-color: #111;
  }

  .dynamic-color-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .dynamic-length-item {
    padding: 10px 24px;
    border: 1px solid #ccc;
    text-decoration: none;
    color: inherit;
  }

  .dynamic-length-item.is-active {
    border: 2px solid #111;
    font-weight: 600;
  }

  .dynamic-length-item:hover {
    border-color: #111;
  }
</style>
