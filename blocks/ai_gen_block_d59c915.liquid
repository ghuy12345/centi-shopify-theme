{% assign ai_gen_id = section.id | replace: '_', '' | replace: '-', '' | downcase %}

{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'LAUNCHING 1ST NOVEMBER'
  assign heading = section.settings.heading | default: 'Join the waitlist'
  assign button_text = section.settings.button_text | default: 'JOIN THE WAITLIST'
  assign success_message = section.settings.success_message | default: "You're on the list. We'll be in touch before launch."
  assign small_print = section.settings.small_print | default: 'By signing up you agree to receive emails from CENTI. You can unsubscribe at any time.'
  assign customer_tags = section.settings.customer_tags | default: 'waitlist, november-launch'
  assign body = section.settings.body | default: '<p>Our bestselling maxi skirt is finally arriving in regular length, alongside a new burgundy suit and brown belt. Everything launches on pre-order on 1st November. Join the waitlist to be the first to know when it goes live.</p>'
-%}

{% style %}
  .ai-waitlist-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 80vh;
    min-height: 80svh;
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
  }
  .ai-waitlist__inner-{{ ai_gen_id }} {
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
    text-align: center;
    color: rgb(var(--color-foreground));
  }
  .ai-waitlist__eyebrow-{{ ai_gen_id }} {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .ai-waitlist__heading-{{ ai_gen_id }} {
    margin: 16px 0 0;
    font-family: var(--font-heading-family);
    font-size: {{ section.settings.heading_size_desktop }}px;
    line-height: 1.15;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: rgb(var(--color-foreground));
  }
  .ai-waitlist__body-{{ ai_gen_id }} {
    margin-top: 20px;
    font-family: var(--font-body-family);
    font-size: 15px;
    line-height: 1.7;
    color: rgba(var(--color-foreground), 0.8);
  }
  .ai-waitlist__body-{{ ai_gen_id }} p { margin: 0; }
  .ai-waitlist__form-wrap-{{ ai_gen_id }} { margin-top: 32px; }
  .ai-waitlist__fields-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
    width: 100%;
  }
  .ai-waitlist__email-{{ ai_gen_id }} {
    min-width: 0;
    flex: 1 1 auto;
    height: 50px;
    padding: 0 15px;
    border: 1px solid rgba(var(--color-foreground), 0.8);
    border-radius: 0;
    background: transparent;
    color: rgb(var(--color-foreground));
    font-family: var(--font-body-family);
    font-size: 14px;
    box-sizing: border-box;
    -webkit-appearance: none;
  }
  .ai-waitlist__email-{{ ai_gen_id }}::placeholder {
    color: rgba(var(--color-foreground), 0.55);
  }
  .ai-waitlist__email-{{ ai_gen_id }}:focus-visible,
  .ai-waitlist__button-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 3px;
  }
  .ai-waitlist__button-{{ ai_gen_id }} {
    flex: 0 0 auto;
    height: 50px;
    padding: 0 28px;
    border: 1px solid rgb(var(--color-button));
    border-radius: 0;
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    font-family: var(--font-body-family);
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .ai-waitlist__button-{{ ai_gen_id }}:hover { opacity: 0.85; }
  .ai-waitlist__error-{{ ai_gen_id }} {
    margin: 12px 0 0;
    text-align: left;
    font-family: var(--font-body-family);
    font-size: 13px;
    line-height: 1.5;
    color: rgb(var(--color-foreground));
  }
  .ai-waitlist__error-{{ ai_gen_id }} ul { margin: 0; padding-left: 20px; }
  .ai-waitlist__success-{{ ai_gen_id }} {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 20px;
    line-height: 1.5;
    color: rgb(var(--color-foreground));
  }
  .ai-waitlist__small-print-{{ ai_gen_id }} {
    margin: 16px 0 0;
    font-family: var(--font-body-family);
    font-size: 11px;
    line-height: 1.5;
    color: rgba(var(--color-foreground), 0.6);
  }
  @media screen and (max-width: 749px) {
    .ai-waitlist__heading-{{ ai_gen_id }} { font-size: {{ section.settings.heading_size_mobile }}px; }
    .ai-waitlist__fields-{{ ai_gen_id }} { flex-direction: column; }
    .ai-waitlist__email-{{ ai_gen_id }},
    .ai-waitlist__button-{{ ai_gen_id }} { width: 100%; }
  }
{% endstyle %}

<div class="ai-waitlist-{{ ai_gen_id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="ai-waitlist__inner-{{ ai_gen_id }}">
    <p class="ai-waitlist__eyebrow-{{ ai_gen_id }}">{{ eyebrow | escape }}</p>
    <h1 class="ai-waitlist__heading-{{ ai_gen_id }}">{{ heading | escape }}</h1>
    <div class="ai-waitlist__body-{{ ai_gen_id }}">{{ body }}</div>

    <div class="ai-waitlist__form-wrap-{{ ai_gen_id }}" id="Waitlist-{{ section.id }}">
      {% form 'customer', id: 'WaitlistForm-{{ section.id }}' %}
        {% if form.posted_successfully? %}
          <p class="ai-waitlist__success-{{ ai_gen_id }}" tabindex="-1">{{ success_message | escape }}</p>
        {% else %}
          <input type="hidden" name="contact[accepts_marketing]" value="true">
          <input type="hidden" name="contact[tags]" value="{{ customer_tags | escape }}">
          <div class="ai-waitlist__fields-{{ ai_gen_id }}">
            <input
              class="ai-waitlist__email-{{ ai_gen_id }}"
              type="email"
              name="contact[email]"
              value="{{ form.email | escape }}"
              placeholder="Email address"
              aria-label="Email address"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="WaitlistError-{{ section.id }}"{% endif %}
            >
            <button class="ai-waitlist__button-{{ ai_gen_id }}" type="submit">{{ button_text | escape }}</button>
          </div>
          {% if form.errors %}
            <div class="ai-waitlist__error-{{ ai_gen_id }}" id="WaitlistError-{{ section.id }}" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
        {% endif %}
      {% endform %}
    </div>

    {% if small_print != blank %}
      <p class="ai-waitlist__small-print-{{ ai_gen_id }}">{{ small_print | escape }}</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Waitlist Signup",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "LAUNCHING 1ST NOVEMBER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the waitlist" },
    { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>Our bestselling maxi skirt is finally arriving in regular length, alongside a new burgundy suit and brown belt. Everything launches on pre-order on 1st November. Join the waitlist to be the first to know when it goes live.</p>" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "JOIN THE WAITLIST" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "You're on the list. We'll be in touch before launch." },
    { "type": "text", "id": "small_print", "label": "Small print", "default": "By signing up you agree to receive emails from CENTI. You can unsubscribe at any time." },
    { "type": "text", "id": "customer_tags", "label": "Customer tags", "default": "waitlist, november-launch" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size desktop", "min": 32, "max": 64, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size mobile", "min": 24, "max": 44, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Waitlist Signup" }]
}
{% endschema %}